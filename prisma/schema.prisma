generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("VENDEDOR") // ADMIN, GERENTE, VENDEDOR, BODEGA
  password  String   // hashed
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  quotes      Quote[]
  commissions Commission[]
  comments    Comment[]
}

model Client {
  id                String   @id @default(cuid())
  name              String
  company           String?
  contact           String?
  email             String?
  phone             String?
  address           String?
  state             String?
  zip               String?
  city              String
  country           String
  receptionSchedule String?  // horario de recepción
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  quotes Quote[]
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  city      String
  country   String
  address   String?
  state     String?
  zip       String?
  phone     String?
  email     String?
  timezone  String   @default("America/Mexico_City")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]
  quotes    Quote[]
  orders    Order[]
  users     User[]
  comments  Comment[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  color       String?
  basePrice   Float
  costPrice   Float?   // Only visible to admin/gerente
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory  Inventory[]
  quoteItems QuoteItem[]
  comments   Comment[]
}

model Inventory {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Float    @default(0) // Soporte para decimales (ej: 2.5 sacos)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique // Ej: IkalChukum - COT - YYYY-MM-DD - NombreCliente - 000123
  clientId    String
  userId      String
  status      String      @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED

  currency     String @default("MXN") // MXN, USD, etc.
  exchangeRate Float  @default(1.0)

  subtotal     Float
  shippingCost Float  @default(0.0)
  discount     Float  @default(0.0)
  tax          Float
  total        Float

  deliveryMethod String @default("ENVIO") // ENVIO, RECOLECTA
  notes          String?
  shippingCarrier  String?
  shippingDuration String?

  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client      @relation(fields: [clientId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  warehouseId String?
  warehouse   Warehouse?  @relation(fields: [warehouseId], references: [id])
  items      QuoteItem[]
  order      Order?
  commission Commission?
}

model QuoteItem {
  id        String @id @default(cuid())
  quoteId   String
  productId String
  quantity  Float
  unitPrice Float
  total     Float

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id                  String      @id @default(cuid())
  quoteId             String      @unique
  warehouseId         String?     // Bodega surtidora
  status              String      @default("PENDING") // PENDING, PREPARING, SHIPPED, DELIVERED, CANCELLED
  scheduledDeliveryAt DateTime?
  deliveredAt         DateTime?
  acknowledgedAt      DateTime?
  acknowledgedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingLabelUrl    String?    // Enlace al PDF de la guía generada
  trackingNumber      String?    // Código de rastreo de la paquetería
  shippoTransactionId String?    // ID de la transacción en Shippo
  shippoPickupId      String?    // ID de la recolección agendada

  quote     Quote      @relation(fields: [quoteId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
}

model Commission {
  id            String           @id @default(cuid())
  quoteId       String           @unique
  userId        String
  amount        Float
  status        String           @default("PENDING") // PENDING, SCHEDULED, PAID, CANCELLED
  scheduledDate DateTime?        // 15 days after scheduled delivery
  paidDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String   // 'Quote', 'Order', 'Product'
  entityId  String
  action    String   // 'CREATE', 'UPDATE', 'DELETE'
  userId    String?
  details   String?  // JSON stringified
  createdAt DateTime @default(now())
}

model SystemSetting {
  key   String @id
  value String
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  productId   String?
  warehouseId String?
  userId      String
  createdAt   DateTime @default(now())

  product   Product?   @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
}

model Backup {
  id        String   @id @default(cuid())
  filename  String
  data      String   // Contenido JSON con todos los registros
  createdAt DateTime @default(now())
}

